{
  "compilerOptions": {
    "module": "esnext",    
    "target": "es2023",                            
    "rootDir": "./",
    "outDir": "./dist",  
    "moduleResolution": "bundler", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}

